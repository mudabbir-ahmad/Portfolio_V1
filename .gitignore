# Dependencies
node_modules

# Build output
dist

# Personal data — never uploaded, at all costs
secrets/

# The CV contains personal details; only the README placeholder ships
public/CV/*
!public/CV/README.txt

# Local env / editor cruft
*.local
.DS_Store

# Local scratch
.claude/
.gh-*.json
scripts/diff-tracker.mjs

# Real values for the container (compose merges the override file in)
docker-compose.override.yml
/.env

# Screenshot capture: cloned source for git-based projects, and raw hand-taken shots
# (the processed images in public/images/projects/ are kept)
.capture-work/
scripts/capture/manual/*/
