# For running WITHOUT Docker (npm run dev / npm start): copy this file to
# secrets/.env and fill in your own values. secrets/ is gitignored.
# Docker does NOT read this file; set the same values in docker-compose.yml.
VITE_NAME=Your Name
VITE_EMAIL=you@example.com
VITE_GITHUB_USER=your-github-username
VITE_LINKEDIN=https://www.linkedin.com/in/your-profile
VITE_CV_URL=/CV/your-cv.pdf
VITE_UNIVERSITY=Your University
# Demo mode: leave VITE_EMAIL, VITE_LINKEDIN and VITE_CV_URL empty to hide those buttons.

# Server-side only (server/index.js). Deliberately not prefixed with VITE_,
# so Vite never inlines these into the browser bundle.
# Powers the contribution graph. Use a fine-grained PAT scoped to your own
# account only, read-only, no repository access selected. The server is the
# only thing that ever sees it now, but keep it minimal-scope regardless.
GITHUB_TOKEN=
# Exact origin(s) allowed to call /api/* (your deployed domain).
ALLOWED_ORIGIN=https://example.com
PORT=3001

# Encryption in transit. Pick ONE:
#  a) Terminate TLS in this server: paths to PEM files (e.g. Let's Encrypt).
# TLS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/example.com/privkey.pem
#  b) Behind a TLS reverse proxy: redirect any plain-HTTP request to HTTPS.
# FORCE_HTTPS=true

