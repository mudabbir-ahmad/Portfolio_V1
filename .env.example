# Copy this file to secrets/.env and fill in your own values.
# secrets/ is gitignored, so real values never leave your machine.
VITE_NAME=Your Name
VITE_LOCATION=City, Country
VITE_EMAIL=you@example.com
VITE_GITHUB_USER=your-github-username
VITE_LINKEDIN=https://www.linkedin.com/in/your-profile
VITE_CV_URL=/CV/Bob-CV.pdf

# Server-side only (server/index.js). Deliberately not prefixed with VITE_,
# so Vite never inlines these into the browser bundle.
# Powers the contribution graph. Use a fine-grained PAT scoped to your own
# account only, read-only, no repository access selected. The server is the
# only thing that ever sees it now, but keep it minimal-scope regardless.
GITHUB_TOKEN=
# Exact origin(s) allowed to call /api/* (your deployed domain).
ALLOWED_ORIGIN=https://mudabbir.co.uk
PORT=3001
